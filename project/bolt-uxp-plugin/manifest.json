{
  "id": "com.eneskul.sequence-browser",
  "name": "Sequence Browser",
  "version": "1.1.0",
  "main": "dist/backend/index.js",
  "host": [
    {
      "app": "PProj",
      "minVersion": "25.6.0"
    }
  ],
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "sequenceBrowserPanel",
      "label": "Sequence Browser",
      "minimumSize": {
        "width": 200,
        "height": 100
      },
      "maximumSize": {
        "width": 800,
        "height": 600
      },
      "preferredDockedSize": {
        "width": 400,
        "height": 500
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 500
      },
      "hostConfig": {
        "type": "panel"
      },
      "webview": {
        "src": "dist/webview/index.html",
        "enableMessageBridge": true
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "read"
  }
}
